{
  "name": "@audc/pcap",
  "version": "4.2.0",
  "description": "raw packet capture, decoding, and analysis",
  "author": "Matt Ranney <mjr@ranney.com>",
  "license": "MIT",
  "maintainers": [
    "Ujjwal Thaakar <ujjwalthaakar@gmail.com>"
  ],
  "main": "./pcap",
  "types": "pcap.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/audiocodes/node_pcap"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "install": "node-gyp-build || (node-gyp rebuild --release -j max && node-gyp clean)",
    "prebuild": "prebuildify --napi --strip --tag-libc",
    "rebuild": "node-gyp rebuild --release -j max",
    "test": "grunt"
  },
  "binary": {
    "module_path": "out"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "grunt": "^1.6.3",
    "grunt-cli": "^1.5.0",
    "grunt-eslint": "^27.0.0",
    "grunt-mocha-istanbul": "^5.0.2",
    "grunt-mocha-test": "^0.13.3",
    "istanbul": "^0.4.5",
    "mocha": "^12.0.1",
    "mocha-sinon": "^2.1.2",
    "prebuildify": "^6.0.1",
    "should": "^13.2.3",
    "sinon": "^22.1.0"
  },
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  }
}
